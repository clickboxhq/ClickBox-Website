# ─── Public (Vite frontend) ───────────────────────────────────────────────────
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ─── Server-only (Vercel → Settings → Environment Variables) ─────────────────
# NEVER prefix these with VITE_ — they must not ship to the browser bundle.
ADMIN_EMAIL=info@useclickbox.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=at-least-16-random-characters-for-jwt-signing

# Optional on Vercel production (enables persistent JSON store across deploys)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# DEPRECATED — Vercel uses vercel.json for headers.
# See DEPLOYMENT.md. Retained for reference only.
# Cloudflare Pages custom headers
# Applied in addition to Cloudflare's default security headers

# ── HTML: never cache so browsers always fetch fresh hashed bundles ──────────
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# Root path alias
/
  Cache-Control: no-cache, no-store, must-revalidate

# ── Hashed JS/CSS assets: immutable 1-year cache ────────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Static logo & icons: short cache with revalidation ─────────────────────
/clickbox-logo.jpeg
  Cache-Control: public, max-age=86400, must-revalidate

/site.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/manifest+json

# ── Security headers for all responses ───────────────────────────────────────
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://challenges.cloudflare.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self';
